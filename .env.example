# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SECRET_KEY=your_server_only_secret_key
# Legacy fallback; use SUPABASE_SECRET_KEY for new Supabase projects.
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Shopify webhook secrets. Prefer one server-only JSON map for every store.
# Example: {"store-a.myshopify.com":"secret-a","store-b.myshopify.com":"secret-b"}
SHOPIFY_WEBHOOK_SECRETS_JSON={}

# Production URL
APP_URL=https://your-production-domain.com
# Required in production: random 32+ character value that signs opaque route click IDs.
ROUTER_CLICK_SIGNING_SECRET=replace_with_a_random_32_plus_character_secret
# Optional, but recommended: a random 32+ character string for signing admin sessions.
ADMIN_SESSION_SECRET=replace_with_a_random_32_plus_character_secret
